{
  "expo": {
    "name": "Bóra",
    "slug": "bora-mobile",
    "scheme": "bora",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.fiocruz.mobile.bora",
      "icon": "./assets/app-store/bora-icon-1024.png",
      "buildNumber": "158",
      "infoPlist": {
        "NSCameraUsageDescription": "O Bóra usa a câmera para ler o QR Code dos eventos e confirmar sua presença."
      },
      "appleTeamId": "7XGS938TCR"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#002542",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.fiocruz.mobile.bora",
      "permissions": [
        "android.permission.health.READ_EXERCISE"
      ],
      "versionCode": 157
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "usePrecompiledModules": false
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "O Bóra lê treinos salvos no Saúde, inclusive por outros dispositivos, para você escolher quais importar para sua jornada e calcular Energia Vital.",
          "NSHealthUpdateUsageDescription": "O Bóra consulta treinos do Saúde e não grava nem altera dados no Saúde.",
          "background": false
        }
      ],
      "./plugins/with-android-dev-support",
      "./plugins/with-health-rationale",
      "react-native-health-connect",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "O Bóra usa a câmera para ler o QR Code dos eventos e confirmar sua presença.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true,
          "microphonePermission": false
        }
      ],
      "./plugins/with-testflight-api",
      "./plugins/with-android-release-api",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#002542",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#002542",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
